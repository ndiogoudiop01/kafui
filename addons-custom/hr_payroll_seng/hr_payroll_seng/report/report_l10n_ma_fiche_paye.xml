                                </t>

								<t t-if="line.code  in ['CPP']">
                                <span t-esc="'%.0f'% o.employee_id.conge_pris"/>
                                </t>
								
								<t t-if="line.code  in ['CMH']">
                                <span t-esc="'%.0f'% o.employee_id.conge_maladie_h"/>
                                </t>								
								
								<t t-if="line.code  in ['CMD']">
                                <span t-esc="'%.0f'% o.employee_id.conge_maladie_j"/>
                                </t>								
								<t t-if="line.code  in ['CMP']">
                                <span t-esc="'%.0f'% o.employee_id.conge_paye"/>
                                </t>
								<t t-if="line.code  in ['CMN']">
                                <span t-esc="'%.0f'% o.employee_id.conge_naissance"/>
                                </t>	

								<t t-if="line.code  in ['CMF']">
                                <span t-esc="'%.0f'% o.employee_id.conge_evenement"/>
                                </t>
								
							 <t t-if="line.code == 'IPRESS'">
                                 
								<span t-esc="'%.2f'% o.employee_id.company_id.t_ipres_s"/>%
                                </t>
								
								 <t t-if="line.code == 'IPRESSC'">
                                 
								<span t-esc="'%.2f'% o.employee_id.company_id.t_ipres_sc"/>%
                                </t>	
								
								 <t t-if="line.code == 'AMOS'">
                                 
								<span t-esc="'%.2f'% o.employee_id.company_id.t_amos"/>%
                                </t>

                                <t t-if="line.code  in ['NETM']">
								<span></span>
                                </t>
								
								<t t-if="line.code == 'ANC'">
								<span t-esc="'%.0f'% o.contract_id.anciennete"/>(ans) 
                                </t>

                                <t t-if="line.code == 'EPART'">
								<span t-esc="'%.2f'% o.employee_id.part"/> (parts)
