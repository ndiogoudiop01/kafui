	<img t-attf-src="data:image/*;base64,{{company_id.logo}}" t-att-alt="company_id.name"/></TH>

	<TH style="font-family:Calibri;font-size: medium; border:solid black 1px;"  colspan="4" class="cadre11" ><h2 >BULLETIN DE PAIE</h2><P><span t-field="o.number"/></P></TH>
