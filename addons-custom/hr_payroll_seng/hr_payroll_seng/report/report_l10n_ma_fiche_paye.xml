	<TD style="text-align:center;border:solid black 1px;" colspan="2" ><span style="font-family:Verdana;font-size: small" t-field="o.contract_id.job_id"/></TD><TD  style="text-align:center;border:solid black 1px" colspan="2" ><span style="font-family:Verdana;font-size: small" t-field="o.contract_id.date_start"/></TD>
	<TD  style="text-align:center;border:solid black 1px" colspan="2"><span style="font-family:Verdana;font-size: small" t-field="o.contract_id.name"/></TD> <TD  style="text-align:center;border:solid black 1px" colspan="2" ><span style="font-family:Verdana;font-size: small"  t-esc="'%.0f'% o.employee_id.parts"/></TD>
