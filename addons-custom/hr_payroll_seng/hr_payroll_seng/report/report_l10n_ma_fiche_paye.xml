                                </t>
                                <t t-if="line.code  in ['IPRESPC','IPRESSC']">
                                <span t-esc="'%.0f'% min((o.gross_wage),o.employee_id.company_id.plafond3)"/>
                                </t>
                                <t t-if="line.code  in ['AMOS','AMOP']">
                                <span t-esc="'%.0f'% min((o.gross_wage),o.employee_id.company_id.plafond4)"/>
                                </t>

								  <t t-if="line.code == 'IR'">
                                <span t-esc="'%.0f'% o.irpp_total"/>
