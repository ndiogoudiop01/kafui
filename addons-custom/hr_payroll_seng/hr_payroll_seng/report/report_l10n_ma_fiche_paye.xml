								<!-- <span t-esc="'%.0f'% o.employee_id.avance"/>  -->
                                <!-- </t> -->

                                <!-- <t t-if="line.code == 'RETN'"> -->
								<!-- <span t-esc="'%.0f'% o.employee_id.retenues"/> -->
                                <!-- </t> -->
                                 <!-- <t t-if="line.code == 'RPRET'"> -->
								<!-- <span t-esc="'%.0f'% o.employee_id.montatdeduire"/>  -->
                                <!-- </t> -->

                            </td>

                            <td style="font-family:Calibri;font-size: medium; border:solid black 1px;">
                                 <t t-if="line.code not in ['WDAYS','WHOURS','IPRESP','IPRESPC','CSSPF','CSSAT','CFCE','AMOP']">
                                      <span t-esc="'%.0f'% line.total or ''"/>
                                </t>
                            </td>
							
							 <td style="font-family:Calibri;font-size: medium; border:solid black 1px;">
                              
                              <t t-if="line.code == 'IPRESP'">
                                    <span t-esc="'%.2f'% o.employee_id.company_id.t_ipres_p"/>%
                                </t>
								 <t t-if="line.code == 'IPRESPC'">
                                    <span t-esc="'%.2f'% o.employee_id.company_id.t_ipres_pc"/>%
                                </t>
									<t t-if="line.code == 'CSSPF'">
                                    <span t-esc="'%.2f'% o.employee_id.company_id.t_pfam"/>%
                                </t>
								  	<t t-if="line.code == 'CSSAT'">
                                    <span t-esc="'%.2f'% o.employee_id.company_id.accid_trv"/>%
                                </t>

								  
								<t t-if="line.code == 'CFCE'">
                                    <span t-esc="'%.2f'% o.employee_id.company_id.t_tcf"/>%
                                </t>
								
								<t t-if="line.code == 'AMOP'">
                                    <span t-esc="'%.2f'% o.employee_id.company_id.t_amop"/>%
                                </t>
						
								
                            </td>
                            <td style="font-family:Calibri;font-size: medium; border:solid black 1px;">
                                <t t-if="line.code in ['INPSP','IPRESPC','IPRESP','CSSPF','CSSAT','CFCE','AMOP']">
                                    <span t-esc="'%.0f'% line.total or ''"/>
                                </t>
                            </td>


                        </tr>


                    </tbody>
						
						
                   </table>
				   



						
				   
