<?xml version="1.0" encoding="utf-8"?>
<odoo>


	<record id="mode_paysage" model="report.paperformat">
	 <field name="name">format A4 </field>
	<field name="default" eval="True"/>
	<field name="format">A4</field>
	<field name="orientation">Landscape</field>
    <field name="margin_top">5</field>
    <field name="margin_bottom">1</field>
    <field name="margin_left">2</field>
    <field name="margin_right">1</field>
    <field name="header_spacing">0</field>	
	<field name="header_line" eval="False"/>

		</record>


        <record id="action_report_tab" model="ir.actions.report">
            <field name="name">Tableau des déclarations CSS/IPRES</field>
            <field name="model">hr.cnss</field>
            <field name="report_type">qweb-html</field>
            <field name="report_name">hr_payroll_seng.report_paie_tab</field>
            <field name="report_file">hr_payroll_seng.report_paie_tab</field>
            <field name="paperformat_id" ref="hr_payroll_seng.mode_paysage" />			
        </record>


	<template id="report_paie_tab">
	    	    <t t-call="web.html_container">
				<t t-foreach="docs" t-as="o">
	    	     <t t-call="web.basic_layout">

 <div class="page"> 		
	
 <style>

.main-data {
width: 90%;
position: absolute;
top: 20px;
font-size: 80%;
}

.titre {
width: 90%;
position: absolute;
font-size: 110%;
 font-family: Arial, Helvetica, sans-serif;

top: 1px;
left: 10px;
}

</style> 




<div class="main-data">

 <p><strong>Raison Sociale :</strong> <![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><span t-esc="o.company_id.name"></span></p>
  <p><strong>Adresse :</strong> <![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><span t-esc="o.company_id.street"></span><![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><span t-esc="o.company_id.street2"></span></p>   
  <p><strong>N° Employeur :</strong> <![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><![CDATA[&nbsp;]]><span t-esc="o.company_id.org_ss"></span></p>
 


<br/> 
<table class="table table-bordered" >
<thead>
	<tr height="24" style="background-color:#EBEBEB !important" >
	<th colspan="1">N° d'ordre</th>
	<th colspan="2">N° allocataire</th>	
	<th colspan="3">Prénom/Nom </th>
	<th colspan="1">Type contrat</th>	
	<th colspan="2">Emploi occupé</th>
	<th colspan="2">Catégorie</th>
	<th colspan="2">Date entrée</th>	
	<th colspan="2">Date sortie</th>
	<th colspan="2">Salaire Brut</th>		
	<th colspan="2">Salaire assuj.CSS ATMP/PF</th>
	<th colspan="2">Salaire assuj.IPRESS RG</th>	
	<th colspan="2">Salaire assuj.IPRESS RCC</th>	
	<th colspan="2">Cotisation  CSS ATMP</th>
	<th colspan="2">Cotisation CSS PF</th>
	<th colspan="2">Cotisation IPRESS RG</th>	
	<th colspan="2">Cotisation IPRESS RCC </th>


	</tr></thead>
	<tbody>
	<tr t-foreach="o.cnss_lines" t-as="line">
	<td colspan="1"><span t-esc="line_index + 1"/></td>
	<td colspan="2"><span t-esc="line.employee_id.matricule_cnss"></span></td>		
	<td colspan="3"><span t-esc="line.employee_id.name"></span></td>
	<td colspan="1"><span  t-esc="line.employee_id.contract_id.type_ctr"></span></td>
	<td colspan="2"><span  t-esc="line.employee_id.contract_id.job_id.name"></span></td>
	<td colspan="2"><span  t-esc="line.employee_id.contract_id.categorie_id.name"></span></td>	
	<td colspan="2"><span  t-esc="line.employee_id.contract_id.date_start"></span></td>	
	<td colspan="2"><span  t-esc="line.employee_id.contract_id.date_end"></span></td>		
	<td colspan="2"><span  t-esc="'%.0f'% line.brute_total"></span></td>
	<td colspan="2"><span  t-esc="'%.0f'% line.brute_plaf"></span></td>
	<td colspan="2"><span  t-esc="'%.0f'% line.brute_plaf2"></span></td>
	<td colspan="2"><span  t-esc="'%.0f'% line.brute_plaf3"></span></td>	
	<td colspan="2"><span  t-esc="'%.0f'% line.cnss_AT"></span></td>	
	<td colspan="2"><span  t-esc="'%.0f'% line.cnss_PF"></span></td>
	<td colspan="2"><span  t-esc="'%.0f'% line.cnss_IPRERG"></span></td>	
	<td colspan="2"><span  t-esc="'%.0f'% line.cnss_IPRESC"></span></td>	
		
		
	

	</tr></tbody>
