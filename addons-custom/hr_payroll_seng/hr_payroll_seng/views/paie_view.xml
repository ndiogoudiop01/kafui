            <!-- id="paie_menu_view_mode" -->
            <!-- name="Liste selon mode de paiement" -->
            <!-- action="action_paie_form" -->
            <!-- parent="hr_payroll_cameroun.menu_hr_payslip_dec" -->
            <!-- sequence="7" -->
			 <!-- /> -->
        <menuitem
            id="paie_menu_view"
            name="Décompte monétaire"
            action="action_paie_form"
            parent="hr_payroll_seng.menu_hr_payslip_dec"
            sequence="2"
			 />
</odoo>
