            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.ne"/>
            <field name="amount_python_compute">result = CNSS_BASE
result_rate = 16.4</field>
            <field name="note">CNSS part patronale 16,4 % × CNSS_BASE (toutes branches confondues).</field>
        </record>

        <!-- seq 220 : ANPE — Contribution ANPE patronal (1 %) -->
        <record id="rule_ne_anpe" model="hr.salary.rule">
            <field name="name">ANPE patronal</field>
            <field name="code">ANPE</field>
            <field name="sequence" eval="220"/>
