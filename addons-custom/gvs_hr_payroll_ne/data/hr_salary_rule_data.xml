            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.ne"/>
            <field name="amount_python_compute">result = CNSS_BASE
result_rate = 1.0</field>
            <field name="note">Contribution ANPE (Agence Nationale pour l'Emploi) — part patronale 1 % × CNSS_BASE.</field>
        </record>

        <!-- seq 240 : TOT_PAT — Total charges patronales -->
        <record id="rule_ne_tot_pat" model="hr.salary.rule">
            <field name="name">Total charges patronales NE</field>
            <field name="code">TOT_PAT</field>
            <field name="sequence" eval="240"/>
            <field name="category_id" ref="om_hr_payroll.COMP"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.ne"/>
            <field name="amount_python_compute">result = CNSS_PAT + ANPE</field>
            <field name="note">Total charges patronales = CNSS_PAT + ANPE.</field>
        </record>

    </data>
