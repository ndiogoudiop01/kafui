        <!--
            RÈGLES SALARIALES — Paie Bénin
            Source : BJ_Fiche de paie.xlsx + Code du Travail BJ (Loi 98-004) + CGI Bénin

            ── Convention om_hr_payroll ──
            • localdict['result']      = montant Python de la règle
            • localdict['result_rate'] = taux d'affichage
              IMPORTANT : tot_rule = result × result_qty × result_rate / 100
            • 'contract' = hr.version (wage, date_start, etc.)
            • 'inputs.CODE' = BrowsableObject sur les entrées du bulletin.
              Pattern sécurisé : _i = inputs.CODE ; val = (_i.amount or 0.0) if _i else 0.0

            ── Logique CNSS BJ ──
            Vieillesse   : salarié 3,6 % / patronal 6,4 %
            Risques prof : salarié 0 %  / patronal 1 %
            Presta. fam. : salarié 0 %  / patronal 9 %
            VPS          : salarié 0 %  / patronal 4 %
            (base = BRUT_IMP, pas de plafond identifié dans le fichier)

            ── Logique ITS BJ ──
            Barème mensuel progressif (CGI Bénin — formule Excel officielle validée) :
               0 % → 0 – 60 000 FCFA
              10 % → 60 001 – 150 000 FCFA
              15 % → 150 001 – 250 000 FCFA
              19 % → 250 001 – 500 000 FCFA
              30 % → > 500 000 FCFA
            Base arrondie à la tranche de 1 000 inférieure (ARRONDI.INF ;-3).

            ── Prime d'ancienneté BJ ──
            Loi 98-004, Art. 234 :
            2 % à 2 ans d'ancienneté, +1 %/an, plafonné 25 % à 25 ans.

            Toutes les règles : company_id=False, country_id=BJ.
            Isolation : ir.rule dans gvs_hr_payroll_base cache ces règles aux autres pays.
        -->

        <!-- ══════════════════════════════════════════════
             BLOC 0 : TECHNIQUE (NB_JOURS)
        ══════════════════════════════════════════════ -->

        <!-- seq 5 : NB_JOURS — Nombre de jours travaillés (TECH, affiché sur bulletin) -->
        <record id="rule_bj_nb_jours" model="hr.salary.rule">
            <field name="name">Jours travaillés</field>
            <field name="code">NB_JOURS</field>
            <field name="sequence" eval="5"/>
            <field name="category_id" ref="gvs_hr_payroll_bj.TECH_BJ"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="False"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.bj"/>
            <field name="amount_python_compute">_i = inputs.NB_JOURS
if _i and _i.amount:
    result = _i.amount
else:
    _wd = worked_days.WORK100
    result = _wd.number_of_days if _wd else 30.0</field>
            <field name="note">Priorité : 1) Other Input NB_JOURS (saisie manuelle exceptionnelle) si renseigné et non nul ;
2) sinon, nombre de jours de l'onglet "Jours travaillés et entrées" (ligne WORK100). WORK100 est
   calculé par get_worked_day_lines() sur une base calendaire de 30 jours (moins congés éventuels),
   donc directement comparable à 30 ;
3) sinon, 30 jours (mois complet BJ). SB est calculé au prorata wage × NB_JOURS / 30.</field>
        </record>

        <!-- ══════════════════════════════════════════════
             BLOC 1 : ÉLÉMENTS DU BRUT IMPOSABLE (BASIC + ALW)
        ══════════════════════════════════════════════ -->

        <!-- seq 10 : SB — Salaire de base (prorata NB_JOURS / 30) -->
        <record id="rule_bj_sb" model="hr.salary.rule">
            <field name="name">Salaire de base</field>
            <field name="code">SB</field>
            <field name="sequence" eval="10"/>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.bj"/>
            <field name="amount_python_compute">result = contract.wage * min(NB_JOURS, 30.0) / 30.0</field>
            <field name="note">SB proraté = wage × NB_JOURS / 30. Mois complet (30j) = salaire plein. Si NB_JOURS = 0
(absence totale), SB = 0 — ne PAS utiliser "NB_JOURS if NB_JOURS else 30.0" : 0 est une valeur valide
(falsy en Python) qui serait sinon incorrectement remplacée par 30 (mois complet payé).</field>
        </record>

        <!-- seq 20 : PR_ANC — Prime d'ancienneté (auto depuis date_start) -->
        <record id="rule_bj_pr_anc" model="hr.salary.rule">
            <field name="name">Prime d'ancienneté</field>
            <field name="code">PR_ANC</field>
            <field name="sequence" eval="20"/>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.bj"/>
            <field name="amount_python_compute">today = payslip.date_to
start = contract.date_start
if start and today:
    years = today.year - start.year - ((today.month, today.day) &lt; (start.month, start.day))
    years = max(years, 0)
    # Code du Travail BJ — Loi 98-004, Art. 234 :
    # 2 % à 2 ans, +1 %/an, plafond 25 % à 25 ans.
    if years &gt;= 2:
        rate = min(years, 25)
    else:
        rate = 0
else:
    rate = 0
result = round(contract.wage * rate / 100.0)</field>
            <field name="note">Loi 98-004 BJ, Art. 234 : 0 % si &lt; 2 ans ; 2 % à 2 ans ; +1 %/an ; plafond 25 %.
result = wage × rate / 100 calculé directement (évite aléas de result_rate).</field>
        </record>

