        <!-- ══════════════════════════════════════════════
             BLOC 4 : COTISATIONS SALARIALES (DED)
        ══════════════════════════════════════════════ -->

        <!-- seq 110 : ITS — Impôt sur le Traitement et Salaire (barème mensuel progressif) -->
        <record id="rule_bj_its" model="hr.salary.rule">
            <field name="name">ITS</field>
            <field name="code">ITS</field>
            <field name="sequence" eval="110"/>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.bj"/>
            <field name="amount_python_compute"># Barème mensuel ITS Bénin (CGI BJ — formule Excel officielle validée)
# Base arrondie à la tranche de 1 000 inférieure (ARRONDI.INF ;-3)
#  0 % [0–60 000] ; 10 % [60 001–150 000] ; 15 % [150 001–250 000]
# 19 % [250 001–500 000] ; 30 % [> 500 000]
_b = int(BRUT_IMP // 1000) * 1000
if _b &lt;= 60000:
    _its = 0.0
elif _b &lt;= 150000:
    _its = (_b - 60000) * 0.10
elif _b &lt;= 250000:
    _its = 9000.0 + (_b - 150000) * 0.15
elif _b &lt;= 500000:
    _its = 9000.0 + 15000.0 + (_b - 250000) * 0.19
else:
    _its = 9000.0 + 15000.0 + 47500.0 + (_b - 500000) * 0.30
result = -round(_its)</field>
            <field name="note">ITS barème mensuel progressif (CGI Bénin — formule Excel validée).
Base = ARRONDI.INF(BRUT_IMP ; -3) → arrondi à la tranche de 1 000 inférieure.
Retenue salariale uniquement (pas de part patronale).</field>
        </record>

