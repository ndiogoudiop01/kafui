<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.payroll</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="46"/>
        <field name="inherit_id" ref="om_hr_payroll.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add custom Senegalese payroll settings inside the payroll app block -->
            <xpath expr="//app[@name='om_hr_payroll']" position="inside">
                <block title="Paie sénégalaise">
                    <setting string="Nombre de jours alloués par an" id="nbj_alloue_setting">
                        <field name="nbj_alloue"/>
                    </setting>
                    <setting string="Nombre de jours de travail par mois" id="nbj_travail_setting">
                        <field name="nbj_travail"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
