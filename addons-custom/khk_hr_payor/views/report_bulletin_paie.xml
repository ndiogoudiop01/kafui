<?xml version="1.0" encoding="utf-8"?>
<!-- by khk -->
<odoo>
<data>
       
        <record id="bulletin_paie" model="ir.actions.report">
            <field name="name">Bulletin de Paie</field>
            <field name="model">hr.payslip</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">khk_hr_payor.report_bulletin_paie</field>
            <field name="report_file">khk_hr_payor.report_bulletin_paie</field>
            <field name="print_report_name">'Bulletin de Paie - %s' % (object.name)</field>
            <field name="binding_model_id" ref="model_hr_payslip"/>
            <field name="binding_type">report</field>
        </record>


<template id="report_bulletin_paie">
    <t t-call="web.html_container">
        <t t-foreach="docs" t-as="o">
          <!--<t t-call="khk_hr_payor.headerless_layout">-->
             <t t-call="khk_hr_payor.custom_external_layout_bulletin">
                <div class="page">
                  <t t-call="khk_hr_payor.header_new"/>
                  <table style="width:100%; border-collapse:collapse; border:1px solid #333; font-family:Arial, sans-serif; text-align:left;">
                    <tr>
                      <td colspan="5" style="padding:4px; border:1px solid #ccc;">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 80px;" alt="Logo"/>
                      </td>
                      <td colspan="5" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Période de Paie </strong>
                      </td>
                    </tr>
                    <tr>
                      <td colspan="5" align="left" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="res_company.street"/> <span t-field="res_company.city"/> <span t-field="res_company.country_id.name"/>
                      </td>
                      <td colspan="5" align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.date_from"/> au <span t-field="o.date_to"/>
                      </td>
                    </tr>
                    <tr>
                      <td rowspan="2" colspan="5" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> <h2> BULLETIN DE PAIE </h2> </strong>
                      </td>
                      <td colspan="5" align="center" style="padding:4px; border:1px solid #ccc;width:36%;">
                        Paiement le <span t-field="o.date_to"/> <!--par <span t-field="o.typePaiement"/>-->
                      </td>
                    </tr>
                    <tr style="background-color: #339ad5;">
                      <td align="center" colspan="2" style="padding:4px; border:1px solid #ccc;">
                        <strong> Convention Collective <span t-field="o.contract_id.convention_id.conv_id.name"/></strong>
                      </td>
                    </tr>
                    <!---->
                    <!--<tr style="background-color: #339ad5;">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> N° IPRES Employeur </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> N° CSS Employeur </strong>
                      </td>
                    </tr>-->
                    <!---->
                    <!--<tr>
                      <t t-if="o.employee_id.ipres">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.employee_id.ipres"/>
                      </td>
                      </t>
                      <t t-else="">
                        <td style="padding:4px; border:1px solid #ccc; text-align:center;"><![CDATA[&nbsp;]]></td>
                      </t>
                      <t t-if="o.employee_id.matricule_cnss">
                        <td align="center" style="padding:4px; border:1px solid #ccc;">
                          <span t-field="o.employee_id.matricule_cnss"/>
                        </td>
                      </t>
                      <t t-else="">
                        <td style="padding:4px; border:1px solid #ccc; text-align:center;"><![CDATA[&nbsp;]]>
                        </td>
                      </t>
                    </tr>-->
                    <!--<tr>
                      <td style="padding:4px; border:1px solid #ccc;" colspan="2">
                      </td>
                    </tr>-->
                    <!---->
                    <tr style="background-color: #339ad5;">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Date d'Entrée </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Poste </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Catégorie </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Ancienneté </strong>
                      </td>
                      <td colspan="5" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> <span t-field="o.employee_id.name"/> </strong>
                      </td>
                    </tr>
                    <!---->
                    <tr>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.contract_id.date_start"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.employee_id.job_id.name"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.contract_id.convention_id.name"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_anciennte.get(o.id, [])[0]"/>
                      </td>
                      <td colspan="5" rowspan="3" align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="o.employee_id.private_street"/>
                      </td>
                    </tr>

                    <tr style="background-color: #339ad5;">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong>Matricule </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Statut </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> TRIMF </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> IR </strong>
                      </td>
                    </tr>

                    <tr>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.employee_id.num_chezemployeur"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.marital"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.employee_id.trimf"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="o.employee_id.ir"/>
                      </td>
                    </tr>
                  </table>

                  <br/>

                  <table style="width:100%; border-collapse:collapse; border:1px solid #333; font-family:Arial, sans-serif; text-align:left;">
                    <tr style="background-color: #339ad5;">
                      <td rowspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Code </strong>
                      </td>
                      <td rowspan="2" colspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Libellé </strong>
                      </td>
                      <td rowspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Base </strong>
                      </td>
                      <td rowspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Taux </strong>
                      </td>
                      <td colspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Part Salariale </strong>
                      </td>
                      <td colspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Charges Patronales </strong>
                      </td>
                    </tr>
                    <tr style="background-color: #339ad5;">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Gains </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Retenues </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Taux </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Retenues </strong>
                      </td>
                    </tr>
                    <!-- foreach for brut imposable -->
                    <tr t-foreach="get_payslip_imposable.get(o.id, [])" t-as="p">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="p.code"/>
                      </td>
                      <td colspan="2" align="left" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="p.name"/>
                      </td>
                      <!--section handler nb days if holidays-->
                      <td t-if="p.salary_rule_id.code == 'C1060'" align="center" style="padding:4px; border:1px solid #ccc;">
                          <span t-field="o.holiday_of_payslip"/>
                      </td>
                      <!--end section handler nb days if hilidays-->
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.amount).replace(',', ' ')"/>
                      </td>
                      <!--section for HS-->
                      <td t-if="p.salary_rule_id.code == 'HS15'" align="right" style="padding:4px; border:1px solid #ccc;">
                      <t t-set="val" t-value="[p for p in o.input_line_ids if p.code == 'HS15']" />
                        <span t-esc="'{0:,.2f}'.format(val[0].amount).replace(',', ' ')"/>
                      </td>
                      <td t-if="p.salary_rule_id.code == 'HS40'" align="right" style="padding:4px; border:1px solid #ccc;">
                      <t t-set="val" t-value="[p for p in o.input_line_ids if p.code == 'HS40']" />
                        <span t-esc="'{0:,.2f}'.format(val[0].amount).replace(',', ' ')"/>
                      </td>
                      <td t-if="p.salary_rule_id.code == 'HS60'" align="right" style="padding:4px; border:1px solid #ccc;">
                      <t t-set="val" t-value="[p for p in o.input_line_ids if p.code == 'HS60']" />
                        <span t-esc="'{0:,.2f}'.format(val[0].amount).replace(',', ' ')"/>
                      </td>
                      <td t-if="p.salary_rule_id.code == 'HS100'" align="right" style="padding:4px; border:1px solid #ccc;">
                      <t t-set="val" t-value="[p for p in o.input_line_ids if p.code == 'HS100']" />
                        <span t-esc="'{0:,.2f}'.format(val[0].amount).replace(',', ' ')"/>
                      </td>
                      <!--end section for HS-->
                      <td t-if="p.salary_rule_id.code not in ['HS15', 'HS40', 'HS60', 'HS100']" align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.1f}'.format(p.rate).replace(',', ' ')"/>%
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.total).replace(',', ' ')"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                    </tr>
                    <!-- end foreach for brut imposable -->

                    <!-- foreach for rubrique non imposable -->
                    <tr t-foreach="get_payslip_non_imposable.get(o.id, [])" t-as="p">
                      <td  align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="p.code"/>
                      </td>
                      <td colspan="2" align="left" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="p.name"/>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.amount).replace(',', ' ')"/>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.1f}'.format(p.rate).replace(',', ' ')"/>%
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.total).replace(',', ' ')"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                    </tr>
                    <!-- end foreach for rubrique non imposable -->

                    <!-- foreach for cotisation sociale -->
                    <tr t-foreach="get_payslip_cotisation.get(o.id, [])" t-as="p">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="p.code"/>
                      </td>
                      <td colspan="2" align="left" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="p.name"/>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.amount).replace(',', ' ')"/>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <t t-if="p.category_id.code != 'COMP'">
                          <span t-esc="'{0:,.1f}'.format(p.rate).replace(',', ' ')"/>%
                        </t>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <t t-if="p.category_id.code == 'SALC'">
                          <span t-esc="'{0:,.0f}'.format(p.total).replace(',', ' ')"/>
                        </t>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <t t-if="p.category_id.code == 'COMP'">
                          <span t-esc="'{0:,.1f}'.format(p.rate).replace(',', ' ')"/>%
                        </t>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <t t-if="p.category_id.code == 'COMP'">
                          <span t-esc="'{0:,.0f}'.format(p.total).replace(',', ' ')"/>
                        </t>
                      </td>
                    </tr>
                    <!-- end foreach for cotisation sociale -->

                    <!-- foreach for retenues -->
                    <tr t-foreach="get_payslip_retenu.get(o.id, [])" t-as="p">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="p.code"/>
                      </td>
                      <td colspan="2" align="left" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="p.name"/>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.amount).replace(',', ' ')"/>
                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.1f}'.format(p.rate).replace(',', ' ')"/>%
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                      <td align="right" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="'{0:,.0f}'.format(p.total).replace(',', ' ')"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">

                      </td>
                    </tr>
                    <!-- end foreach for retenues -->
                    <tr>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td colspan="2" style="padding:4px; border:1px solid #ccc;"></td>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;width:10%; background-color: #339ad5;">
                        <strong> T. Gains </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc; background-color: #339ad5;">
                        <strong> T. Retenues </strong>
                      </td>
                      <td colspan="2" align="center" style="padding:4px; border:1px solid #ccc; background-color: #339ad5;">
                        <strong> T. Charges Patronales </strong>
                      </td>
                    </tr>

                    <tr>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td colspan="2" style="padding:4px; border:1px solid #ccc;"></td>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td style="padding:4px; border:1px solid #ccc;"></td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_total_gains.get(o.id)[0]"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_total_charg_sal.get(o.id)[0]"/>
                      </td>
                      <td colspan="2" align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_total_charge_pat.get(o.id)[0]"/>
                      </td>
                    </tr>
                  </table>
                  <br/>

                  <table style="width:100%; border-collapse:collapse; border:1px solid #333; font-family:Arial, sans-serif; text-align:left;">
                    <tr style="background-color: #339ad5;">
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Salaire Brut Total </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Salaire Brut Imposable </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> Congés payés restants </strong>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <strong> NET A PAYER </strong>
                      </td>
                    </tr>

                    <tr>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_sal_brut.get(o.id)[0]"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_sal_brut_imp.get(o.id)[0]"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-field="o.employee_id.remaining_leaves"/>
                      </td>
                      <td align="center" style="padding:4px; border:1px solid #ccc;">
                        <span t-esc="get_sal_net.get(o.id)[0]"/>
                      </td>
                    </tr>

                  </table>
                  <br/>
                  <p><strong> Pour vous aider à faire valoir vos droits, conservez ce bulletin de paie sans limitation de durée. </strong></p>
                </div>
            <!-- </t> -->
          </t>
        </t>
    </t>
</template>

</data>
</odoo>
