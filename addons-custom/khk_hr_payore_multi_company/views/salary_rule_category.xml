<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_salary_rule_category_form_inherit_for_company_id" model="ir.ui.view">
        <field name="name">hr.salary.rule.category.form.inherit.company_id</field>
        <field name="model">hr.salary.rule.category</field>
        <field name="inherit_id" ref="om_hr_payroll.hr_salary_rule_category_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="company_id" groups="base.group_multi_company"/>
            </xpath>
        </field>
    </record>
</odoo>
