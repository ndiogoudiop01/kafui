        <!-- ── seq 80 : ANC ── Prime d'ancienneté -->
        <!-- Règle : 0% avant 2 ans, 2% de 2 à 3 ans,
             à partir de la 4ème année : 2% + 1%/an au-delà de 3 ans,
             plafonné à 35%.

             Date de référence : fin de période du bulletin (payslip.dict.date_to).
             Cela garantit que l'ancienneté est calculée sur tout le mois du
             bulletin — un employé qui atteint 2 ans EN COURS DE MOIS reçoit
             bien la prime sur le bulletin entier, sans attendre le mois suivant.

             Date d'embauche = la PLUS ANCIENNE parmi :
               - contract.dateAnciennete  (khk_hr_payor, si renseignée)
               - contract.contract_date_start (date de début du contrat)
             On prend min() pour donner le maximum d'ancienneté à l'employé
             et pour ne pas pénaliser ceux dont dateAnciennete a été mal importée.
             Ne PAS utiliser contract.date_start = max(date_version, contract_date_start)
             qui renvoie la date de migration pour les employés importés. -->
        <record id="rule_tg_anc" model="hr.salary.rule">
            <field name="name">Prime d'ancienneté</field>
            <field name="code">ANC</field>
            <field name="sequence" eval="80"/>
            <field name="category_id" ref="om_hr_payroll.ALW"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.tg"/>
            <field name="amount_python_compute">_d1 = contract.dateAnciennete if ('dateAnciennete' in contract._fields and contract.dateAnciennete) else None
_d2 = contract.contract_date_start or None
_anc_ref = min(_d1, _d2) if (_d1 and _d2) else (_d1 or _d2)
_anc_end = payslip.dict.date_to
nb_years = max(0, int((_anc_end - _anc_ref).days / 365)) if _anc_ref else 0
if nb_years &lt; 2:
    taux = 0.0
elif nb_years &lt; 4:
    taux = 0.02
else:
    taux = min(0.02 + (nb_years - 3) * 0.01, 0.35)
result = round(BASIC * taux)</field>
            <field name="note">Plafond 35%. 0% avant 2 ans. 2% de 2 à 3 ans. A partir de la 4ème année : 2% + 1% par année supplémentaire au-delà de 3 ans. L'ancienneté est calculée au dernier jour du mois du bulletin.</field>
        </record>

