        <!-- ================================================================
             RÈGLES SALARIALES — TOGO — BULLETIN MENSUEL
             Structure : "Togo — Bulletin mensuel" (TG_MENS, unique)

             company_id=False : règles globales, visibles par toutes les
             sociétés. Elles ne s'appliquent qu'aux contrats utilisant la
             structure TG_MENS. Bulletins et employés restent liés à leur
             société.

             API om_hr_payroll v19 (règles amount_select='code') :
               • categories.CODE       (NOT categories['CODE'])
               • CODE                  (total de la règle CODE déjà calculée)
               • contract.wage         (salaire de base contractuel)
             ================================================================ -->

        <!-- ── seq 10 : TECH_JOURS ── Nombre de jours payés (défaut 30) -->
        <record id="rule_tg_tech_jours" model="hr.salary.rule">
            <field name="name">Jours payés (base 30)</field>
            <field name="code">TECH_JOURS</field>
            <field name="sequence" eval="10"/>
            <field name="category_id" ref="gvs_hr_payroll_tg.TECH"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="is_prorata" eval="False"/>
            <field name="appears_on_payslip" eval="False"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.tg"/>
            <field name="amount_python_compute">_wd = worked_days.WORK100
result = _wd.number_of_days if _wd else 30.0</field>
            <field name="note">Nombre de jours payés = nombre de jours de l'onglet "Jours travaillés et entrées" (ligne WORK100) si renseigné, sinon 30 (mois complet). WORK100 est calculé par get_worked_day_lines() sur une base calendaire de 30 jours (moins congés éventuels) — pas sur le calendrier hebdomadaire — donc directement comparable à 30. Un élément variable (hr.employee.bonus) ciblant cette règle reste prioritaire et écrase ce calcul (pour les cas particuliers non couverts par WORK100).</field>
        </record>

        <!-- ── seq 30 : BASIC ── Salaire de base proratisé × jours/30 -->
        <record id="rule_tg_basic" model="hr.salary.rule">
            <field name="name">Salaire de base</field>
            <field name="code">BASIC</field>
            <field name="sequence" eval="30"/>
            <field name="category_id" ref="om_hr_payroll.BASIC"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.tg"/>
            <field name="amount_python_compute">result = contract.wage * min(TECH_JOURS, 30) / 30</field>
            <field name="note">contract.wage = salaire de base du contrat. Proratisé sur min(TECH_JOURS, 30) / 30 (le plafond évite tout dépassement si WORK100 &gt; 30 jours).</field>
        </record>

