        <!-- ── seq 265 : IND_KM_NI ── Indemnité kilométrique non imposable -->
        <!-- Catégorie ALW_NI : exclue du brut imposable (GROSS), non soumise à
             CNSS/INAM ni à l'IRPP. Réintégrée dans le net via TOT_IND_NT (seq 280).
             Montant par défaut = contract.forfait_km (champ du contrat).
             Peut être écrasé mois par mois via l'onglet Éléments variables. -->
        <record id="rule_tg_ind_km_ni" model="hr.salary.rule">
            <field name="name">Indemnité kilométrique (non imposable)</field>
