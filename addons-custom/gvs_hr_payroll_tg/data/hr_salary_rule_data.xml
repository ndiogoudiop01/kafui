            <field name="appears_on_payslip" eval="False"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.tg"/>
            <field name="amount_python_compute">result = max(0, int((BRUT_IMP - ABAT28 - CHARGE) // 1000) * 1000)</field>
            <field name="note">= brut imposable - abattement 28 % - personnes à charge, arrondi au millier inférieur (ROUNDDOWN).</field>
        </record>

        <!-- ── seq 220 : IRPP ── Impôt progressif barème 2023 (annualisé, dizaine inférieure) -->
        <record id="rule_tg_irpp" model="hr.salary.rule">
            <field name="name">IRPP</field>
            <field name="code">IRPP</field>
            <field name="sequence" eval="220"/>
            <field name="category_id" ref="om_hr_payroll.DED"/>
            <field name="condition_select">none</field>
            <field name="amount_select">code</field>
            <field name="appears_on_payslip" eval="True"/>
            <field name="company_id" eval="False"/>
            <field name="country_id" ref="base.tg"/>
            <field name="amount_python_compute">a = BASE_IRPP * 12
t = (0.03 * max(0, min(a, 3000000) - 900000)
     + 0.10 * max(0, min(a, 6000000) - 3000000)
     + 0.15 * max(0, min(a, 9000000) - 6000000)
     + 0.20 * max(0, min(a, 12000000) - 9000000)
     + 0.25 * max(0, min(a, 15000000) - 12000000)
     + 0.30 * max(0, min(a, 20000000) - 15000000)
     + 0.35 * max(0, a - 20000000))
result = -(int(max(t, 3000) / 120) * 10) * (a > 0)</field>
            <field name="note">Barème 2023 : 0%(0-900k), 3%(900k-3M), 10%(3-6M), 15%(6-9M), 20%(9-12M), 25%(12-15M), 30%(15-20M), 35%(>20M). Minimum 3 000 F/an. Arrondi dizaine inférieure.</field>
        </record>

