<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================================================
         Action rapport — Bulletin de Paie Togo
         S'ajoute dans le menu "Imprimer" sur hr.payslip
         ================================================================ -->
    <record id="action_report_bulletin_paie_tg" model="ir.actions.report">
        <field name="name">Bulletin de Paie Togo</field>
        <field name="model">hr.payslip</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gvs_hr_payroll_tg.report_bulletin_paie_tg_template</field>
        <field name="report_file">gvs_hr_payroll_tg.report_bulletin_paie_tg_template</field>
        <field name="print_report_name">('Bulletin Togo - %s - %s' % (object.employee_id.name, object.date_from.strftime('%m/%Y') if object.date_from else ''))</field>
        <field name="binding_model_id" ref="om_hr_payroll.model_hr_payslip"/>
        <field name="binding_type">report</field>
        <field name="domain">[('company_id.country_id.code', '=', 'TG')]</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- ================================================================
         Template QWeb — Bulletin de Paie Togo
         Layout conforme à la fiche TOULASSI Kossi :
           En-tête employeur | Identité employé | Table gains/retenues
           Section récapitulatif (IRPP, CNSS 4%, charges patronales)
         ================================================================ -->
    <template id="report_bulletin_paie_tg_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="font-size:10pt; padding-top:15px;">

                        <!-- ═══ EN-TÊTE ═══ -->
                        <table width="100%" style="margin-bottom:6px; border-collapse:collapse;">
                            <tr>
                                <td style="width:50%; vertical-align:top;">
                                    <!-- Nom employeur (logo déjà présent dans l'en-tête de page via web.external_layout) -->
                                    <strong style="font-size:12pt;">
                                        <t t-esc="o.company_id.name"/>
                                    </strong>
                                    <t t-if="o.company_id.vat">
                                        <br/>NIF : <t t-esc="o.company_id.vat"/>
                                    </t>
                                    <t t-if="o.company_id.company_registry">
                                        <br/>RCCM : <t t-esc="o.company_id.company_registry"/>
                                    </t>
                                    <br/>
                                    <t t-esc="o.company_id.street or ''"/>
                                    <t t-if="o.company_id.city">
                                        — <t t-esc="o.company_id.city"/>
                                    </t>
                                </td>
                                <td style="width:50%; vertical-align:top; text-align:right;">
                                    <h3 style="margin:0; color:#1a5276;">BULLETIN DE PAIE</h3>
                                    <p style="margin:4px 0;">
                                        Mois de :
                                        <strong>
                                            <t t-esc="o.date_from" t-options="{'widget': 'date', 'format': 'MMMM yyyy'}"/>
                                        </strong>
                                    </p>
                                    <p style="margin:4px 0;">
                                        Période du
                                        <strong><t t-esc="o.date_from" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></strong>
                                        au
                                        <strong><t t-esc="o.date_to" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/></strong>
                                    </p>
                                    <t t-if="o.number">
                                        <p style="margin:4px 0;">Réf. : <t t-esc="o.number"/></p>
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <hr style="border:1px solid #1a5276; margin:4px 0;"/>

                        <!-- ═══ IDENTITÉ EMPLOYÉ ═══ -->
                        <table width="100%" style="margin-bottom:6px; border-collapse:collapse; font-size:9pt;">
                            <tr>
                                <td style="width:25%;"><strong>Employé :</strong></td>
                                <td style="width:35%;"><t t-esc="o.employee_id.name"/></td>
                                <td style="width:20%;"><strong>N° CNSS Employé :</strong></td>
                                <td style="width:20%;"><t t-esc="o.employee_id.ssnid or ''"/></td>
                            </tr>
                            <tr>
                                <td><strong>Grade / Poste :</strong></td>
                                <td><t t-esc="o.employee_id.job_id.name or ''"/></td>
                                <td><strong>Date d'entrée :</strong></td>
                                <td>
                                    <t t-if="o.version_id and o.version_id.date_start">
                                        <t t-esc="o.version_id.date_start" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td><strong>Département :</strong></td>
                                <td><t t-esc="o.employee_id.department_id.name or ''"/></td>
                                <td><strong>Personnes à charge :</strong></td>
                                <td>
                                    <!-- Nombre de personnes à charge saisi comme entrée PERS_CHARGE -->
                                    <t t-set="pc_line" t-value="o.input_line_ids.filtered(lambda l: l.code == 'PERS_CHARGE')"/>
                                    <t t-esc="int(pc_line[0].amount) if pc_line else 0"/>
                                </td>
                            </tr>
                        </table>

                        <hr style="border:1px solid #cccccc; margin:4px 0;"/>

                        <!-- ═══ TABLEAU DES RUBRIQUES ═══
                             Colonnes : Code | Rubriques | Base | Taux/NB | Retenues | Gains
                        -->
                        <table width="100%" style="border-collapse:collapse; font-size:9pt; margin-bottom:6px;">
                            <thead>
                                <tr style="background:#1a5276; color:white; text-align:center;">
                                    <th style="border:1px solid #aaa; padding:3px; width:8%;">Code</th>
                                    <th style="border:1px solid #aaa; padding:3px; width:30%;">Rubriques</th>
                                    <th style="border:1px solid #aaa; padding:3px; width:15%; text-align:right;">Base</th>
                                    <th style="border:1px solid #aaa; padding:3px; width:10%; text-align:right;">Taux/NB</th>
                                    <th style="border:1px solid #aaa; padding:3px; width:17%; text-align:right;">Retenues</th>
                                    <th style="border:1px solid #aaa; padding:3px; width:17%; text-align:right;">Gains</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- ── Gains imposables (BASIC + ALW) ── -->
                                <t t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code in ('BASIC', 'ALW'))" t-as="line">
                                    <tr>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.code"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.name"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <!-- Base = montant avant taux (ex. ANC : salaire de base) -->
                                            <t t-if="line.code == 'ANC' or (line.rate and line.rate != 100.0)">
                                                <t t-esc="'{:,.0f}'.format(abs(line.amount)).replace(',', ' ')"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <t t-if="line.code == 'ANC' or (line.rate and line.rate != 100.0)">
                                                <t t-esc="'{:.2f} %'.format(line.rate)"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;"></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <t t-esc="'{:,.0f}'.format(line.total).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- ── SALAIRE BRUT (GROSS) ── -->
                                <t t-set="gross_line" t-value="o.line_ids.filtered(lambda l: l.code == 'GROSS')"/>
                                <t t-if="gross_line">
                                    <tr style="background:#e8f4f8; font-weight:bold;">
                                        <td style="border:1px solid #aaa; padding:2px 4px;">GROSS</td>
                                        <td style="border:1px solid #aaa; padding:2px 4px;">SALAIRE BRUT</td>
                                        <td style="border:1px solid #aaa; padding:2px 4px; text-align:right;"></td>
                                        <td style="border:1px solid #aaa; padding:2px 4px; text-align:right;"></td>
                                        <td style="border:1px solid #aaa; padding:2px 4px; text-align:right;"></td>
                                        <td style="border:1px solid #aaa; padding:2px 4px; text-align:right;">
                                            <t t-esc="'{:,.0f}'.format(gross_line[0].total).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- ── Retenues légales (DED : CNSS, IRPP, TCS) ── -->
                                <t t-set="base_irpp_v" t-value="o.line_ids.filtered(lambda l: l.code == 'BASE_IRPP')"/>
                                <t t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code == 'DED' and l.code in ('CNSS', 'IRPP', 'TCS'))" t-as="line">
                                    <tr>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.code"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.name"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <!-- Base : GROSS pour CNSS, BASE_IRPP pour IRPP -->
                                            <t t-if="line.code == 'CNSS' and gross_line">
                                                <t t-esc="'{:,.0f}'.format(gross_line[0].total).replace(',', ' ')"/>
                                            </t>
                                            <t t-elif="line.code == 'IRPP' and base_irpp_v">
                                                <t t-esc="'{:,.0f}'.format(base_irpp_v[0].total).replace(',', ' ')"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <!-- Taux : 9 % fixe pour CNSS, taux effectif calculé pour IRPP -->
                                            <t t-if="line.code == 'IRPP' and base_irpp_v and base_irpp_v[0].total">
                                                <t t-esc="'{:.2f} %'.format(abs(line.total) / base_irpp_v[0].total * 100)"/>
                                            </t>
                                            <t t-elif="line.rate and line.rate != 100.0">
                                                <t t-esc="'{:.2f} %'.format(line.rate)"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <t t-esc="'{:,.0f}'.format(abs(line.total)).replace(',', ' ')"/>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;"></td>
                                    </tr>
                                </t>

                                <!-- ── Total Retenues Légales ── -->
                                <t t-set="tot_ret_leg_line" t-value="o.line_ids.filtered(lambda l: l.code == 'TOT_RET_LEG')"/>
                                <t t-if="tot_ret_leg_line">
                                    <tr style="background:#fef9e7; font-weight:bold;">
                                        <td style="border:1px solid #aaa; padding:2px 4px;"></td>
                                        <td style="border:1px solid #aaa; padding:2px 4px;">TOTAL RETENUES LÉGALES</td>
                                        <td style="border:1px solid #aaa; padding:2px 4px;"></td>
                                        <td style="border:1px solid #aaa; padding:2px 4px;"></td>
                                        <td style="border:1px solid #aaa; padding:2px 4px; text-align:right;">
                                            <t t-esc="'{:,.0f}'.format(abs(tot_ret_leg_line[0].total)).replace(',', ' ')"/>
                                        </td>
                                        <td style="border:1px solid #aaa; padding:2px 4px;"></td>
                                    </tr>
                                </t>

                                <!-- ── Indemnités non taxables (ALW_NI) ── -->
                                <t t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code == 'ALW_NI')" t-as="line">
                                    <tr>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.code"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.name"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;"></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <t t-if="line.rate and line.rate != 100.0">
                                                <t t-esc="'{:.2f} %'.format(line.rate)"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;"></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <t t-esc="'{:,.0f}'.format(line.total).replace(',', ' ')"/>
                                        </td>
                                    </tr>
                                </t>

                                <!-- ── Avance sur salaire et autres retenues (DED hors légales) ── -->
                                <t t-foreach="o.line_ids.filtered(lambda l: l.appears_on_payslip and l.category_id.code == 'DED' and l.code in ('AV_SAL', 'AUTRE_RET'))" t-as="line">
                                    <tr>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.code"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"><t t-esc="line.name"/></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"></td>
                                        <td style="border:1px solid #ddd; padding:2px 4px; text-align:right;">
                                            <t t-if="line.total != 0">
                                                <t t-esc="'{:,.0f}'.format(abs(line.total)).replace(',', ' ')"/>
                                            </t>
                                        </td>
                                        <td style="border:1px solid #ddd; padding:2px 4px;"></td>
                                    </tr>
                                </t>

                                <!-- ── NET À PAYER ── -->
                                <t t-set="net_line" t-value="o.line_ids.filtered(lambda l: l.code == 'NET')"/>
                                <tr style="background:#1a5276; color:white; font-weight:bold; font-size:11pt;">
                                    <td style="border:1px solid #aaa; padding:4px;" colspan="2">NET À PAYER</td>
                                    <td style="border:1px solid #aaa; padding:4px;"></td>
                                    <td style="border:1px solid #aaa; padding:4px;"></td>
                                    <td style="border:1px solid #aaa; padding:4px;"></td>
                                    <td style="border:1px solid #aaa; padding:4px; text-align:right;">
                                        <t t-if="net_line">
                                            <t t-esc="'{:,.0f}'.format(net_line[0].total).replace(',', ' ')"/> FCFA
                                        </t>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ═══ RÉCAPITULATIF EMPLOYEUR ═══ -->
                        <t t-set="base_irpp_line"   t-value="o.line_ids.filtered(lambda l: l.code == 'BASE_IRPP')"/>
                        <t t-set="cnss_ouv4_line"   t-value="o.line_ids.filtered(lambda l: l.code == 'CNSS_OUV_4')"/>
                        <t t-set="cnss_pat_line"    t-value="o.line_ids.filtered(lambda l: l.code == 'CNSS_PAT')"/>
                        <t t-set="tot_charge_line"  t-value="o.line_ids.filtered(lambda l: l.code == 'TOT_CHARGE_PAT')"/>

                        <table width="100%" style="border-collapse:collapse; font-size:9pt; margin-top:8px;">
                            <tr style="background:#d6eaf8;">
                                <td colspan="4" style="padding:3px 6px; font-weight:bold; border:1px solid #aaa;">
                                    RÉCAPITULATIF EMPLOYEUR
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #ddd; padding:2px 6px; width:40%;">Base imposable IRPP</td>
                                <td style="border:1px solid #ddd; padding:2px 6px; text-align:right; width:20%;">
                                    <t t-if="base_irpp_line">
                                        <t t-esc="'{:,.0f}'.format(base_irpp_line[0].total).replace(',', ' ')"/> F
                                    </t>
                                </td>
                                <td style="border:1px solid #ddd; padding:2px 6px; width:40%;">
                                    Charges patronales CNSS (17,5 %)
                                </td>
                                <td style="border:1px solid #ddd; padding:2px 6px; text-align:right; width:20%;">
                                    <t t-if="cnss_pat_line">
                                        <t t-esc="'{:,.0f}'.format(cnss_pat_line[0].total).replace(',', ' ')"/> F
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="border:1px solid #ddd; padding:2px 6px;">
                                    Cotisations ouvrières CNSS (4 %)
                                </td>
                                <td style="border:1px solid #ddd; padding:2px 6px; text-align:right;">
                                    <t t-if="cnss_ouv4_line">
                                        <t t-esc="'{:,.0f}'.format(abs(cnss_ouv4_line[0].total)).replace(',', ' ')"/> F
                                    </t>
                                </td>
                                <td style="border:1px solid #ddd; padding:2px 6px; font-weight:bold;">
                                    COÛT EMPLOYEUR TOTAL
                                </td>
                                <td style="border:1px solid #ddd; padding:2px 6px; text-align:right; font-weight:bold;">
                                    <t t-if="tot_charge_line">
                                        <t t-esc="'{:,.0f}'.format(tot_charge_line[0].total).replace(',', ' ')"/> F
                                    </t>
                                </td>
                            </tr>
                        </table>

                        <!-- ═══ ZONE SIGNATURE ═══ -->
                        <table width="100%" style="margin-top:24px; border-collapse:collapse;">
                            <tr>
                                <td style="width:45%; text-align:center; vertical-align:bottom;">
                                    <p>Le / La salarié(e)</p>
                                    <br/><br/>
                                    <p style="border-top:1px solid #333; margin-top:20px; padding-top:4px;">Signature</p>
                                </td>
                                <td style="width:10%;"></td>
                                <td style="width:45%; text-align:center; vertical-align:bottom;">
                                    <p>Pour l'employeur</p>
                                    <br/><br/>
                                    <p style="border-top:1px solid #333; margin-top:20px; padding-top:4px;">Cachet et signature</p>
                                </td>
                            </tr>
                        </table>

                    </div><!-- /page -->
                </t><!-- /external_layout -->
            </t><!-- /foreach docs -->
        </t><!-- /html_container -->
    </template>

</odoo>
