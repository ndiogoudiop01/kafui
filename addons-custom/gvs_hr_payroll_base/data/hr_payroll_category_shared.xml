<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!--
        Rend génériques (sans société) les catégories de règles salariales
        installées par om_hr_payroll.

        Problème : om_hr_payroll crée ces catégories avec company_id = société
        courante au moment de l'installation.  Comme elles sont utilisées par
        TOUTES les structures pays (Togo, Sénégal, …), notre ir.rule filtrant
        par pays bloquait leur accès depuis une société d'un autre pays.

        Solution : company_id = False → country_id = False → visible partout
        (notre ir.rule inclut ('country_id', '=', False) dans le domaine).

        noupdate="0" : appliqué à chaque mise à jour du module, même si les
        données ont été modifiées manuellement.
    -->

    <record id="om_hr_payroll.BASIC" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.ALW" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.GROSS" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.DED" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.NET" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.COMP" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.HRA" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.DA" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.Travel" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.Meal" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.Medical" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

    <record id="om_hr_payroll.Other" model="hr.salary.rule.category">
        <field name="company_id" eval="False"/>
    </record>

</odoo>
